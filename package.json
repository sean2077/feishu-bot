{
  "name": "@sean2077/feishu-bot",
  "version": "0.1.0",
  "description": "A Feishu team gateway for native Claude Code sessions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "feishu-bot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node dist/cli.js run",
    "doctor": "node dist/cli.js doctor",
    "check": "npm run typecheck && npm test && npm run build && npm run test:native",
    "test:native": "node --test tests/native-runtime.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@larksuite/channel": "0.7.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
