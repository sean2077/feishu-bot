{
  "tenantId": "tenant_example",
  "appId": "cli_example_app",
  "appSecretEnv": "FEISHU_APP_SECRET",
  "dataDir": "./state",
  "runtime": { "maxWorkers": 4 },
  "model": {
    "baseUrl": "https://model.example/anthropic",
    "tokenEnv": "MODEL_AUTH_TOKEN",
