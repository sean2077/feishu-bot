[Unit]
Description=Feishu Claude Code gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=feishu-bot
Group=feishu-bot
WorkingDirectory=/opt/feishu-bot
EnvironmentFile=/etc/feishu-bot/environment
ExecStart=/opt/feishu-bot/bin/feishu-bot run --config /etc/feishu-bot/config.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
