FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git bash ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/feishu-bot
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev --ignore-scripts
ENV NODE_ENV=production HOME=/home/worker CLAUDE_CONFIG_DIR=/home/worker/.claude
USER 1000:1000
ENTRYPOINT ["node", "/opt/feishu-bot/dist/worker.js"]
